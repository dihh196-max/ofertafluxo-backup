# Shopee Open API (use as credenciais fornecidas no portal de Afiliados)
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Cabeçalhos adicionais exigidos pela sua conta no Explorer, se houver, em JSON.
# A autenticação SHA256 padrão é gerada automaticamente pelo bot.
SHOPEE_EXTRA_HEADERS={}
# Caminho da consulta GraphQL exportada do Open API Explorer.
SHOPEE_QUERY_PATH=./config/shopee-offers.graphql

# Filtros
MIN_DISCOUNT_PERCENT=20
MIN_PRICE=0
MAX_PRICE=1000
MAX_OFFERS_PER_RUN=5
PREFERRED_MAX_PRICE=80

# WhatsApp Cloud API — somente números que aceitaram receber as mensagens.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Números em formato internacional, separados por vírgula. Ex.: 5511999999999
WHATSAPP_RECIPIENTS=
# "text" funciona dentro da janela de atendimento de 24h; fora dela, use um template aprovado.
WHATSAPP_MODE=text
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Evolution API (opcional; permite enviar a grupos pela conta conectada por QR Code)
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=ofertafluxo

# Protege POST /run. Gere um valor aleatório longo.
RUN_SECRET=troque-este-segredo
# Para npm run run-once, informe o ID de um usuário cadastrado.
RUN_USER_ID=
PORT=3000
# Por padrão, o painel só atende nesta máquina. Para hospedar, altere PANEL_HOST
# e informe explicitamente a origem HTTPS permitida em PANEL_ALLOWED_ORIGINS.
PANEL_HOST=127.0.0.1
PANEL_ALLOWED_ORIGINS=
# Obrigatória em hospedagem externa; use ao menos 24 caracteres aleatórios.
PANEL_ACCESS_KEY=
